{
  "name": "SEO monthly pull",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1"
            }
          ]
        }
      },
      "id": "mp1",
      "name": "Mondays 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Runs every Monday 07:00 Asia/Kolkata but only does work on the first Monday of the month.\n// The SEO data webhook then starts the site audit, refreshes backlinks and saves a snapshot.\nconst ist = new Date(Date.now() + 5.5 * 3600 * 1000);\nif (ist.getUTCDate() > 7) return [];\nreturn ['dhobico.com', 'acre.realty', 'acgunited.com'].map(site => ({ json: { site } }));"
      },
      "id": "mp2",
      "name": "First Monday only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:5678/webhook/seo-data",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "site",
              "value": "={{ $json.site }}"
            }
          ]
        },
        "options": {
          "timeout": 290000,
          "batching": {
            "batch": {
              "batchSize": 1
            }
          },
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "mp3",
      "name": "Call SEO data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "w0hhe8u3m6LJqaMX",
          "name": "SEO data token"
        }
      }
    }
  ],
  "connections": {
    "Mondays 07:00": {
      "main": [
        [
          {
            "node": "First Monday only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "First Monday only": {
      "main": [
        [
          {
            "node": "Call SEO data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  }
}