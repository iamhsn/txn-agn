# Copied to /opt/txn-agn/.env by scripts/bootstrap.sh (mode 600, never committed).
# Values marked AUTO are generated on the server. Values marked YOU are added
# on the server with:  sudo /opt/txn-agn/scripts/set-secret NAME

# --- Versions (pinned; bump deliberately, see docs/RUNBOOK.md) ---
POSTGRES_VERSION=16-alpine
N8N_VERSION=                    # AUTO: pinned to the current stable at first install
CLOUDFLARED_VERSION=            # AUTO: pinned at first install

# --- Postgres ---
POSTGRES_USER=admin
POSTGRES_DB=admin
POSTGRES_PASSWORD=              # AUTO
N8N_DB_PASSWORD=                # AUTO

# --- n8n ---
N8N_HOST=flows.techxeon.cloud
N8N_ENCRYPTION_KEY=             # AUTO; also stored in Bitwarden after install. Losing it = losing saved credentials.

# --- Cloudflare ---
CLOUDFLARE_TUNNEL_TOKEN=        # YOU (created by Claude through the Cloudflare connector; paste from dashboard)

# --- Monitoring (Healthchecks.io ping URLs) ---
HC_HEARTBEAT_URL=               # YOU: check "server heartbeat", period 5 min, grace 10 min
HC_BACKUP_URL=                  # YOU: check "nightly backup", period 1 day, grace 2 h

# --- Telegram (alerts + approvals) ---
TELEGRAM_BOT_TOKEN=             # YOU
TELEGRAM_CHAT_ID=               # YOU (send any message to the bot, then see docs/RUNBOOK.md)

# --- Backups to Cloudflare R2 (optional until R2 is enabled) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=txn-agn-backups

# --- Models ---
OPENROUTER_API_KEY=             # YOU ("Livo AI Key", with a monthly limit)
