#!/usr/bin/env bash
# Store a secret in /opt/txn-agn/.env without it appearing on screen or in shell history.
#   sudo /opt/txn-agn/scripts/set-secret OPENROUTER_API_KEY
set -euo pipefail
ENV=/opt/txn-agn/.env
NAME=${1:?usage: set-secret NAME}
[[ $NAME =~ ^[A-Z0-9_]+$ ]] || { echo "Bad name: $NAME"; exit 1; }
read -rsp "Value for $NAME (hidden): " VALUE; echo
[[ -n $VALUE ]] || { echo "Empty value, nothing changed."; exit 1; }
tmp=$(mktemp)
if grep -qE "^$NAME=" "$ENV"; then
  awk -v n="$NAME" -v v="$VALUE" -F= 'BEGIN{OFS="="} $1==n{print n, v; next} {print}' "$ENV" > "$tmp"
else
  cat "$ENV" > "$tmp"; printf '%s=%s\n' "$NAME" "$VALUE" >> "$tmp"
fi
install -m 600 "$tmp" "$ENV"; rm -f "$tmp"
echo "Saved $NAME."
cd /opt/txn-agn && docker compose up -d >/dev/null && echo "Services reloaded."
